# ==============================================================================
# Rankora Enterprise Production Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to .env.production on your deployment server (Render/Vercel/VPS):
#      cp .env.production.example .env.production
# 2. Every [REQUIRED] variable must be populated before booting core-service.
#    The service boots with fail-loud safety assertions that will prevent startup
#    if any required secret or connection string is missing or uses insecure defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & PROCESS TOPOLOGY
# ------------------------------------------------------------------------------
# [REQUIRED] Must be 'production'
NODE_ENV=production

# [OPTIONAL] Internal port for core-service API (Default: 5001)
CORE_SERVICE_PORT=5001

# [REQUIRED] Number of reverse-proxy hops to trust for rate-limiting & IP resolution:
# - Set '1' for Render, AWS ALB, Nginx, or Traefik
# - Set '2' for Cloudflare + Render / Cloudflare + AWS ALB
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. SECURITY & ENCRYPTION SECRETS
# ------------------------------------------------------------------------------
# Generate strong 64-character hex keys using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# [REQUIRED] Access token signing secret (minimum 32 characters, non-default)
JWT_ACCESS_SECRET=replace_with_strong_random_32_bytes_hex_string

# [REQUIRED] Refresh token signing secret (minimum 32 characters, non-default)
JWT_REFRESH_SECRET=replace_with_strong_random_32_bytes_hex_string

# [REQUIRED] AES-256-GCM encryption key for OAuth tokens & sensitive credentials (64-char hex)
TOKEN_ENCRYPTION_KEY=replace_with_strong_random_64_char_hex_encryption_key

# ------------------------------------------------------------------------------
# 3. DATABASE & CACHE CONNECTIONS
# ------------------------------------------------------------------------------
# [REQUIRED] MongoDB connection URI (Atlas replica set or managed cluster with TLS)
# Used for: User accounts, workspaces, TTL-indexed SERP caches, scratch logs, dead letters
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rankora_prod?retryWrites=true&w=majority

# [REQUIRED] Redis connection URL (Redis 7+ with noeviction policy configured)
# Used for: BullMQ distributed queues, spatial geo-cache, distributed semaphores, rate limiting
REDIS_URL=redis://default:<password>@redis-host:6379

# [REQUIRED] Must be strictly 'true' in production to prevent silent in-memory fallback
REQUIRE_REDIS=true

# [REQUIRED] PostgreSQL Direct Connection URL (port 5432)
# Used strictly for DDL migrations, rolling partition provisioning, and schema administrative tasks
POSTGRES_DIRECT_URL=postgresql://<user>:<password>@postgres-host:5432/rankora_rankings?sslmode=require

# [REQUIRED] PostgreSQL Pooled Connection URL (PgBouncer transaction mode, port 6432)
# Used for all runtime queries, high-throughput time-series writes, and ranking history queries
POSTGRES_POOL_URL=postgresql://<user>:<password>@pgbouncer-host:6432/rankora_rankings?sslmode=require

# [OPTIONAL] Max client connections allocated for the app runtime pool (Default: 20)
POSTGRES_POOL_MAX=20

# ------------------------------------------------------------------------------
# 4. IN-HOUSE SERP SCRAPER & PROXY CASCADE TIERING
# ------------------------------------------------------------------------------
# [REQUIRED] In-house HTTP scraper provider (strictly 'GOOGLE_MAPS_HTTP')
SERP_PROVIDER=GOOGLE_MAPS_HTTP

# [REQUIRED] Primary Datacenter proxy backbone URL (Webshare / Luminati / IPRoyal)
# Format: http://user:password@gateway-host:port
SCRAPER_PROXY_URL=http://<datacenter_user>:<datacenter_pass>@p.webshare.io:80

# [OPTIONAL] Escalation Residential proxy backbone URL (activated only on CAPTCHA / IP block)
# Format: http://user:password@residential-host:port
RESIDENTIAL_PROXY_URL=http://<resi_user>:<resi_pass>@residential.webshare.io:80

# [REQUIRED] Datacenter proxy bandwidth cost per GB in USD (e.g. 1.50)
PROXY_COST_PER_GB_USD=1.50

# [REQUIRED] Residential proxy bandwidth cost per GB in USD (e.g. 3.50)
RESIDENTIAL_COST_PER_GB_USD=3.50

# [OPTIONAL] Maximum concurrent connections allowed per gateway IP/session (Default: 5)
PROXY_MAX_CONCURRENCY_PER_GATEWAY=5

# [OPTIONAL] Daily hard ceiling budget for SERP proxy spend in USD (Default: 50.00)
SERP_DAILY_BUDGET_USD=50.00

# [OPTIONAL] HTTP fetcher implementation: 'curl-impersonate' (production default) or 'undici'
HTTP_FETCHER=curl-impersonate

# [OPTIONAL] Spatial cache TTL duration in hours (Allowed range: 48 to 72, Default: 60)
SERP_CACHE_TTL_HOURS=60

# ------------------------------------------------------------------------------
# 5. DOMAIN, CORS & APPLICATION URLS
# ------------------------------------------------------------------------------
# [REQUIRED] Frontend web application URL (Vercel production URL or custom domain)
FRONTEND_URL=https://app.rankora.com

# [REQUIRED] Backend API base URL
APP_URL=https://api.rankora.com

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (RESEND)
# ------------------------------------------------------------------------------
# [REQUIRED] Resend live production API key from resend.com/api-keys
RESEND_API_KEY=re_live_production_api_key_here

# [REQUIRED] Verified sender address (DKIM/SPF verified domain at resend.com/domains)
# Prohibited: onboarding@resend.dev sandbox address
EMAIL_FROM=Rankora Alerts <notifications@rankora.com>

# [OPTIONAL] Resend webhook signing secret for tracking bounce/delivery events
RESEND_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 7. ARTIFICIAL INTELLIGENCE & LLM ANALYSIS
# ------------------------------------------------------------------------------
# [REQUIRED] LLM Provider (openai)
AI_PROVIDER=openai

# [REQUIRED] OpenAI API key for competitor insights, review drafting, and audit summaries
OPENAI_API_KEY=sk-proj-live_openai_api_key_here

# [OPTIONAL] Fast cost-effective LLM model identifier (Default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH & GOOGLE BUSINESS PROFILE (GBP)
# ------------------------------------------------------------------------------
# [OPTIONAL] Google OAuth Client ID for GBP location synchronization
GOOGLE_CLIENT_ID=

# [OPTIONAL] Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# [OPTIONAL] Google Places API Key (used for business name autocomplete / Place ID resolution)
GOOGLE_PLACES_API_KEY=
