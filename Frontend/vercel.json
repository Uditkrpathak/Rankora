{
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://rankora-q9dm.onrender.com/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://rankora-q9dm.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
