# ==============================================================================
# Localo / Core Service - Environment Configuration Template (.env.example)
# ==============================================================================

# Database & Cache
MONGO_URI=mongodb://localhost:27017/localo_core
REDIS_URL=redis://localhost:6379
REQUIRE_REDIS=false

# Ingress & Reverse Proxy Topology
# Set to '1' or 'true' when deployed behind a trusted reverse proxy (Cloudflare, AWS ALB, Nginx)
# Leave false / unset in direct deployments to prevent X-Forwarded-For IP spoofing
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# SERP & Proxy Fleet Configuration (Phase 1 & Phase 2)
# ------------------------------------------------------------------------------

# Primary Scraper Provider Mode: 'AUTO' | 'GOOGLE_MAPS_HTTP' | 'DATAFORSEO' | 'SERPAPI' | 'MOCK'
SERP_PROVIDER=AUTO

# HTTP Fetcher Implementation: 'undici' (default) | 'tls' | 'curl-impersonate' | 'cycletls'
HTTP_FETCHER=undici

# Optional custom binary path for curl-impersonate (e.g. /usr/local/bin/curl_chrome116)
# CURL_IMPERSONATE_BIN=/usr/local/bin/curl_chrome116

# Browser Profile Viewport Mode: 'desktop' (1024x768) | 'mobile' (390x844)
MAPS_ENDPOINT_MODE=desktop

# ------------------------------------------------------------------------------
# Tier 1: Datacenter Proxy Fleet (~70% Target Share)
# ------------------------------------------------------------------------------
# Single Datacenter Proxy Gateway URL (HTTP CONNECT proxy)
# Format: http://user:password@gateway.proxyprovider.com:8080
SCRAPER_PROXY_URL=

# Or Multiple Comma-Separated Datacenter Gateway URLs for pool balancing
# SCRAPER_PROXY_URLS=http://user:pass@dc1.proxy.net:8080,http://user:pass@dc2.proxy.net:8080

# Dynamic Datacenter Session & Geo Template (Supports: ${SESSION_ID}, ${COUNTRY}, ${REGION}, ${CITY})
# PROXY_SESSION_TEMPLATE=http://user-session-${SESSION_ID}-country-${COUNTRY}:pass@gateway.proxy.net:8080

# ------------------------------------------------------------------------------
# Tier 1.5: Residential Proxy Fleet (~30% Target Share / Fallback Guarded)
# ------------------------------------------------------------------------------
# Residential Proxy Gateway URL
RESIDENTIAL_PROXY_URL=

# Dynamic Residential Session & Geo Template (Supports: ${SESSION_ID}, ${COUNTRY}, ${REGION}, ${CITY})
# RESIDENTIAL_SESSION_TEMPLATE=http://user-res-session-${SESSION_ID}-country-${COUNTRY}-city-${CITY}:pass@res.proxy.net:8080

# Maximum allowed global residential traffic share before gating (default: 0.30 = 30%)
RESIDENTIAL_MAX_SHARE=0.30

# Action when residential max share is exceeded: 'alert' (log + continue) | 'degrade' (route to managed API)
RESIDENTIAL_SHARE_ACTION=alert

# Per-business daily residential bandwidth limit in bytes (default: 500 MB = 524288000 bytes)
RESIDENTIAL_DAILY_BYTE_CAP=524288000

# ------------------------------------------------------------------------------
# Redis Proxy Health Scoring & Quarantine Configuration
# ------------------------------------------------------------------------------
# Negative score threshold triggering gateway quarantine (default: -3)
PROXY_QUARANTINE_THRESHOLD=-3

# Quarantine duration in seconds (default: 1800s = 30 minutes)
PROXY_QUARANTINE_TTL_SEC=1800

# Rolling health score TTL in seconds (default: 86400s = 24 hours)
PROXY_SCORE_TTL_SEC=86400

# Sticky Session Pool Bounds
PROXY_MAX_REQS_PER_SESSION=5
PROXY_MAX_POOL_SIZE=50

# ------------------------------------------------------------------------------
# Bandwidth Cost Assumptions (Used for telemetry reporting & cost tracking)
# ------------------------------------------------------------------------------
# Datacenter Proxy cost per GB in USD [ASSUMPTION - User configurable]
PROXY_COST_PER_GB_USD=1.50

# Residential Proxy cost per GB in USD [ASSUMPTION - User configurable]
RESIDENTIAL_COST_PER_GB_USD=3.50

# ------------------------------------------------------------------------------
# Tier 3: Managed API Fallback Credentials
# ------------------------------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_API_KEY=

# Headless Browser Playwright Fallback (Disabled by default)
PLAYWRIGHT_FALLBACK_ENABLED=false

# ------------------------------------------------------------------------------
# Keyword Engine V2 - Measured Relevance Thresholds
# Set after live calibration - see docs/calibration-output.md
# ------------------------------------------------------------------------------
# Minimum share of top-10 competitor category match across 5 pins (e.g. 0.45 = 45%)
KEYWORD_MIN_RELEVANCE=0.45

# Minimum number of valid/probed pins required out of 5
KEYWORD_MIN_GOOD_PINS=3

# ------------------------------------------------------------------------------
# Chat AI Copilot & LLM Configuration (Phase 3 & Phase 4)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=10000
AI_MAX_TOKENS=250
AI_TEMPERATURE=0.1
# Cost estimation per 1M tokens in USD (gpt-4o-mini default: $0.15 prompt, $0.60 completion)
AI_INPUT_TOKEN_PRICE_PER_M=0.15
AI_OUTPUT_TOKEN_PRICE_PER_M=0.60

# ------------------------------------------------------------------------------
# Chat AI Copilot Quotas & Emergency Kill Switch (Phase 5)
# ------------------------------------------------------------------------------
# Global kill switch to instantly stop LLM spend (default: true; set false to disable generative path)
CHAT_LLM_ENABLED=true

# Monthly query quotas by workspace subscription plan
CHAT_QUOTA_FREE=50
CHAT_QUOTA_STARTER=150
CHAT_QUOTA_PRO=500
CHAT_QUOTA_AGENCY=2000


